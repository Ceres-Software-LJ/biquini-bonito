---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Boilerplate — Lenis + GSAP">
	<main>
		<section class="hero">
			<p class="eyebrow">Seção 1 · fade-up simples</p>
			<h1>Troque este título</h1>
			<p class="lead">Este parágrafo entra com fade + translateY quando cruza a tela. Veja o script no final da página.</p>
		</section>

		<section class="pin-section">
			<div class="pin-inner">
				<p class="eyebrow">Seção 2 · pin</p>
				<h2>Esta seção fica presa</h2>
				<div class="cards">
					<div class="card">Card 1</div>
					<div class="card">Card 2</div>
					<div class="card">Card 3</div>
				</div>
			</div>
		</section>

		<section class="path-section">
			<p class="eyebrow">Seção 3 · motion path</p>
			<h2>Um elemento seguindo uma curva</h2>
			<svg viewBox="0 0 600 200" class="path-svg">
				<path id="track" d="M20,100 C150,20 450,180 580,100" fill="none" stroke="#ddd" stroke-width="2" />
				<circle id="traveler" r="10" fill="#111" />
			</svg>
		</section>
	</main>

	<style>
		:global(body) {
			margin: 0;
			font-family: -apple-system, sans-serif;
			background: #fafaf8;
			color: #111;
		}
		section {
			min-height: 100vh;
			display: flex;
			flex-direction: column;
			justify-content: center;
			padding: 8vw;
		}
		.eyebrow {
			text-transform: uppercase;
			letter-spacing: 0.1em;
			font-size: 0.75rem;
			color: #888;
		}
		h1, h2 { font-size: clamp(2rem, 6vw, 3.5rem); margin: 0.5rem 0; }
		.lead { max-width: 40ch; color: #555; opacity: 0; transform: translateY(40px); }
		.pin-section { background: #111; color: #fff; }
		.cards { display: flex; gap: 1.5rem; margin-top: 2rem; }
		.card {
			background: #222;
			border: 1px solid #333;
			border-radius: 12px;
			padding: 2rem;
			width: 160px;
			opacity: 0;
			transform: translateY(30px);
		}
		.path-svg { width: 100%; max-width: 600px; }
	</style>

	<script>
		import gsap from 'gsap';
		import { ScrollTrigger } from 'gsap/ScrollTrigger';
		import { MotionPathPlugin } from 'gsap/MotionPathPlugin';

		gsap.registerPlugin(ScrollTrigger, MotionPathPlugin);

		// Seção 1: fade-up simples
		gsap.to('.lead', {
			opacity: 1,
			y: 0,
			duration: 1,
			ease: 'power3.out',
			scrollTrigger: { trigger: '.lead', start: 'top 85%' },
		});

		// Seção 2: pin + cards em stagger
		ScrollTrigger.create({
			trigger: '.pin-section',
			start: 'top top',
			end: '+=800',
			pin: true,
		});
		gsap.to('.card', {
			opacity: 1,
			y: 0,
			duration: 0.6,
			stagger: 0.3,
			ease: 'power3.out',
			scrollTrigger: {
				trigger: '.pin-section',
				start: 'top top',
				end: '+=800',
				scrub: true,
			},
		});

		// Seção 3: motion path amarrado ao scroll
		gsap.to('#traveler', {
			motionPath: {
				path: '#track',
				align: '#track',
				alignOrigin: [0.5, 0.5],
			},
			ease: 'none',
			scrollTrigger: {
				trigger: '.path-section',
				start: 'top bottom',
				end: 'bottom top',
				scrub: true,
			},
		});
	</script>
</Layout>
